<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Digital ID - <%= user.fullName %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 min-h-screen flex items-center justify-center p-4 font-sans">
  <div class="bg-white rounded-3xl shadow-xl overflow-hidden max-w-sm w-full border border-slate-200">
    <!-- Header banner -->
    <div class="bg-slate-900 text-white text-center pt-8 pb-16 px-4 relative">
      <span class="text-[11px] font-bold tracking-widest uppercase text-slate-300">Digital ID</span>
      <h1 class="text-sm font-bold uppercase mt-1 leading-tight tracking-wide">Binakayan Hospital and Medical Center Inc.</h1>
    </div>

    <!-- Profile photo avatar -->
    <div class="relative -mt-12 flex justify-center">
      <div class="w-24 h-24 rounded-full border-4 border-white shadow-md overflow-hidden bg-slate-200">
        <img src="<%= user.photoUrl %>" alt="<%= user.fullName %>" class="w-full h-full object-cover" onerror="this.src='/images/default.png';">
      </div>
    </div>

    <!-- Body Info -->
    <div class="p-6 text-center space-y-4">
      <div>
        <h2 class="text-lg font-extrabold text-slate-900 uppercase tracking-tight"><%= user.fullName %></h2>
        <p class="text-xs font-semibold text-slate-600 uppercase mt-0.5"><%= user.role %></p>
        <p class="text-[11px] font-medium text-slate-400 uppercase tracking-wider"><%= user.department %></p>
      </div>

      <!-- Status badge -->
      <div>
        <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1 rounded-full border border-emerald-200">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          ACTIVE ID
        </span>
      </div>

      <!-- ID Attributes -->
      <div class="border-t border-b border-slate-100 divide-y divide-slate-100 text-xs text-left pt-1 pb-1">
        <div class="flex justify-between py-2">
          <span class="text-slate-400">ID Number</span>
          <span class="font-mono font-bold text-slate-700 uppercase"><%= user.id %></span>
        </div>
        <div class="flex justify-between py-2">
          <span class="text-slate-400">Date of Employment</span>
          <span class="font-medium text-slate-700"><%= user.issuedDate %></span>
        </div>
        <% if (user.email) { %>
        <div class="flex justify-between py-2">
          <span class="text-slate-400">Email</span>
          <span class="font-medium text-slate-700"><%= user.email %></span>
        </div>
        <% } %>
      </div>

      <!-- Scan Verification Metadata -->
      <div class="pt-2 text-[10px] text-slate-400 space-y-0.5">
        <p>Verified at <%= scanTime %></p>
        <p class="font-medium">Official System</p>
      </div>
    </div>
  </div>
</body>
</html>
